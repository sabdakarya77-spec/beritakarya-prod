# ── Environment Configuration ───────────────────────────────────────────────
NODE_ENV=development

# --- FRONTEND CONFIGURATION (NEXT_PUBLIC_ prefix for browser-side access) ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_URL="http://localhost:3000"

# --- ANALYTICS (Optional) ---
NEXT_PUBLIC_GA_ID=""

# --- GOOGLE ADSENSE ---
# Publisher ID (1 per akun AdSense, berlaku untuk semua subdomain)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX

# Ad Unit ID per slot (BEDA dari Publisher ID di atas — angka murni, 1 per unit
# iklan yang dibuat MANUAL di dashboard AdSense: Ads → By ad unit → Display ads
# → Responsive. Baru bisa dibuat setelah akun AdSense approved/review selesai.
# Kosongkan dulu kalau belum ada — slot yang env var-nya kosong otomatis
# tidak render apa-apa (aman, tidak error), tinggal isi kapan saja tanpa ubah kode.
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_FEED_1=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_FEED_2=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=

# --- SITE CONFIGURATION ---
# Uncomment untuk override site default (default: "pusat")
# NEXT_PUBLIC_SITE_ID="pusat"

# ============================================================
# Production (Self-Hosted CT 104 - 10.0.0.14):
#   Salin file ini ke apps/web/.env.production sebelum menjalankan pnpm build:
#   cp apps/web/.env.example apps/web/.env.production
#
#   NEXT_PUBLIC_API_URL="https://api.beritakarya.co"
#   NEXT_PUBLIC_URL="https://beritakarya.co"
#   NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
#   NEXT_PUBLIC_SITE_ID="pusat"
#   NEXT_PUBLIC_ADSENSE_PUBLISHER_ID="pub-XXXXXXXXXXXXXXXX"
#   NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=""        (isi setelah Ad Unit dibuat di dashboard AdSense)
#   NEXT_PUBLIC_ADSENSE_SLOT_HOME_FEED_1=""
#   NEXT_PUBLIC_ADSENSE_SLOT_HOME_FEED_2=""
#   NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=""
#   NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MIDDLE=""
#   NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=""
#
# Backend API di self-hosted CT 102 — lihat apps/api/.env.example.selfhosted
# ============================================================
